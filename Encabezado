import React, { useState, useEffect } from 'react';
import { ShoppingCart, ChefHat, Flame, Leaf, Trash2 } from 'lucide-react';

export default function MenuAntojitos() {
  const [carrito, setCarrito] = useState([]);
  const [mostrarCarrito, setMostrarCarrito] = useState(false);

  // Cargar carrito del localStorage al montar
  useEffect(() => {
    const carritoGuardado = localStorage.getItem('carritoAntojitos');
    if (carritoGuardado) {
      setCarrito(JSON.parse(carritoGuardado));
    }
  }, []);

  // Guardar carrito en localStorage cada vez que cambia
  useEffect(() => {
    localStorage.setItem('carritoAntojitos', JSON.stringify(carrito));
  }, [carrito]);

  const menu = {
    quesadillas: [
      { id: 1, nombre: 'Quesadilla de Flor de Calabaza', precio: 45, picante: 0, vegetariano: true, descripcion: 'Con queso Oaxaca y epazote' },
      { id: 2, nombre: 'Quesadilla de Huitlacoche', precio: 50, picante: 0, vegetariano: true, descripcion: 'El caviar mexicano con queso' },
      { id: 3, nombre: 'Quesadilla de Champiñones', precio: 45, picante: 0, vegetariano: true, descripcion: 'Con ajo y cebolla' },
      { id: 4, nombre: 'Quesadilla de Tinga', precio: 50, picante: 2, vegetariano: false, descripcion: 'Pollo deshebrado en chipotle' }
    ],
    tacos: [
      { id: 5, nombre: 'Tacos al Pastor', precio: 15, picante: 1, vegetariano: false, descripcion: 'Con piña, cilantro y cebolla (orden de 3)' },
      { id: 6, nombre: 'Tacos de Carnitas', precio: 15, picante: 0, vegetariano: false, descripcion: 'Maciza, surtida o mixta (orden de 3)' },
      { id: 7, nombre: 'Tacos de Suadero', precio: 18, picante: 0, vegetariano: false, descripcion: 'Suavecito y jugoso (orden de 3)' },
      { id: 8, nombre: 'Tacos de Pescado', precio: 20, picante: 1, vegetariano: false, descripcion: 'Empanizado con col y aderezo (orden de 3)' }
    ],
    antojitos: [
      { id: 9, nombre: 'Sopes de Tinga', precio: 55, picante: 2, vegetariano: false, descripcion: 'Orden de 3, con frijoles, crema y queso' },
      { id: 10, nombre: 'Sopes de Chorizo', precio: 55, picante: 1, vegetariano: false, descripcion: 'Orden de 3, con frijoles, crema y queso' },
      { id: 11, nombre: 'Huarache Mixto', precio: 75, picante: 1, vegetariano: false, descripcion: 'Grande, con bistec y chorizo, salsa verde' },
      { id: 12, nombre: 'Tlacoyos de Frijol', precio: 50, picante: 0, vegetariano: true, descripcion: 'Orden de 3, con queso, nopales y salsa' },
      { id: 13, nombre: 'Tostadas de Tinga', precio: 40, picante: 2, vegetariano: false, descripcion: 'Orden de 3, con lechuga, crema y queso' },
      { id: 14, nombre: 'Gorditas de Chicharrón', precio: 50, picante: 1, vegetariano: false, descripcion: 'Orden de 3, con salsa verde' }
    ],
    guarniciones: [
      { id: 15, nombre: 'Esquites', precio: 30, picante: 1, vegetariano: true, descripcion: 'Con mayo, queso y chile piquín' },
      { id: 16, nombre: 'Elote Entero', precio: 35, picante: 1, vegetariano: true, descripcion: 'Con todo: mayo, queso, chile y limón' },
      { id: 17, nombre: 'Nopales Asados', precio: 25, picante: 0, vegetariano: true, descripcion: 'Con cebolla, cilantro y limón' },
      { id: 18, nombre: 'Frijoles Charros', precio: 30, picante: 1, vegetariano: false, descripcion: 'Con tocino, chorizo y cilantro' }
    ],
    bebidas: [
      { id: 19, nombre: 'Agua de Jamaica', precio: 25, picante: 0, vegetariano: true, descripcion: 'Litro' },
      { id: 20, nombre: 'Agua de Horchata', precio: 25, picante: 0, vegetariano: true, descripcion: 'Litro' },
      { id: 21, nombre: 'Agua de Tamarindo', precio: 25, picante: 0, vegetariano: true, descripcion: 'Litro' },
      { id: 22, nombre: 'Refresco', precio: 20, picante: 0, vegetariano: true, descripcion: 'Coca, Sprite, Fanta' }
    ]
  };

  const agregarAlCarrito = (item) => {
    setCarrito([...carrito, { ...item, carritoId: Date.now() }]);
  };

  const eliminarDelCarrito = (carritoId) => {
    setCarrito(carrito.filter(item => item.carritoId !== carritoId));
  };

  const vaciarCarrito = () => {
    setCarrito([]);
  };

  const calcularTotal = () => {
    return carrito.reduce((sum, item) => sum + item.precio, 0);
  };

  const obtenerItemsAgrupados = () => {
    const agrupados = {};
    carrito.forEach(item => {
      if (!agrupados[item.id]) {
        agrupados[item.id] = { ...item, cantidad: 0 };
      }
      agrupados[item.id].cantidad += 1;
    });
    return Object.values(agrupados);
  };

  const nivelPicante = (nivel) => {
    const flames = [];
    for (let i = 0; i < nivel; i++) {
      flames.push(<Flame key={i} className="w-4 h-4 text-red-500 inline" />);
    }
    return flames;
  };

  const SeccionMenu = ({ titulo, items, icono }) => (
    <div className="mb-8">
      <h2 className="text-2xl font-bold text-amber-800 mb-4 flex items-center gap-2 border-b-2 border-amber-600 pb-2">
        <span className="text-3xl">{icono}</span>
        {titulo}
      </h2>
      <div className="grid gap-4">
        {items.map(item => (
          <div key={item.id} className="bg-white p-4 rounded-lg shadow-md hover:shadow-lg transition-shadow border-l-4 border-amber-500">
            <div className="flex justify-between items-start mb-2">
              <div className="flex-1">
                <h3 className="font-bold text-lg text-gray-800 flex items-center gap-2">
                  {item.nombre}
                  {item.vegetariano && <Leaf className="w-4 h-4 text-green-600" />}
                  {item.picante > 0 && <span className="ml-2">{nivelPicante(item.picante)}</span>}
                </h3>
                <p className="text-gray-600 text-sm mt-1">{item.descripcion}</p>
              </div>
              <div className="text-right ml-4">
                <p className="text-xl font-bold text-amber-700">${item.precio}</p>
                <button
                  onClick={() => agregarAlCarrito(item)}
                  className="mt-2 bg-amber-600 text-white px-4 py-1 rounded-full text-sm hover:bg-amber-700 transition-colors"
                >
                  Agregar
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );

  return (
    <div className="min-h-screen bg-gradient-to-b from-amber-50 to-orange-50">
      {/* Header */}
      <div className="bg-gradient-to-r from-amber-700 to-orange-600 text-white p-6 shadow-lg">
        <div className="max-w-6xl mx-auto">
          <div className="flex justify-between items-center">
            <div>
              <h1 className="text-4xl font-bold flex items-center gap-3">
                <ChefHat className="w-10 h-10" />
                Antojitos Mexicanos
              </h1>
              <p className="text-amber-100 mt-2">Lo mejor de la comida tradicional mexicana</p>
            </div>
            <button
              onClick={() => setMostrarCarrito(!mostrarCarrito)}
              className="bg-white text-amber-700 px-6 py-3 rounded-full font-bold hover:bg-amber-50 transition-colors flex items-center gap-2 shadow-lg"
            >
              <ShoppingCart className="w-5 h-5" />
              Carrito ({carrito.length})
            </button>
          </div>
        </div>
      </div>

      {/* Carrito desplegable */}
      {mostrarCarrito && (
        <div className="max-w-6xl mx-auto mt-4 bg-white p-6 rounded-lg shadow-xl border-2 border-amber-500">
          <div className="flex justify-between items-center mb-4">
            <h2 className="text-2xl font-bold text-amber-800">Tu Pedido</h2>
            {carrito.length > 0 && (
              <button
                onClick={vaciarCarrito}
                className="bg-red-600 text-white px-4 py-2 rounded-full text-sm hover:bg-red-700 transition-colors"
              >
                Vaciar Carrito
              </button>
            )}
          </div>
          {carrito.length === 0 ? (
            <p className="text-gray-500">No hay artículos en el carrito</p>
          ) : (
            <>
              {obtenerItemsAgrupados().map((item) => (
                <div key={item.id} className="flex justify-between items-center py-2 border-b">
                  <div className="flex-1">
                    <span className="font-semibold text-gray-800">{item.nombre}</span>
                    <span className="text-gray-600 text-sm ml-2">x{item.cantidad}</span>
                  </div>
                  <div className="flex items-center gap-4">
                    <span className="font-bold text-amber-700">${item.precio * item.cantidad}</span>
                    <button
                      onClick={() => {
                        const itemAEliminar = carrito.find(c => c.id === item.id);
                        if (itemAEliminar) {
                          eliminarDelCarrito(itemAEliminar.carritoId);
                        }
                      }}
                      className="bg-red-500 text-white p-2 rounded hover:bg-red-600 transition-colors"
                      title="Eliminar una unidad"
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              ))}
              <div className="mt-4 pt-4 border-t-2 border-amber-500">
                <div className="flex justify-between text-2xl font-bold text-amber-800">
                  <span>TOTAL:</span>
                  <span>${calcularTotal()}</span>
                </div>
              </div>
            </>
          )}
        </div>
      )}

      {/* Menú */}
      <div className="max-w-6xl mx-auto p-6">
        <div className="bg-amber-100 border-l-4 border-amber-600 p-4 mb-6 rounded">
          <p className="text-amber-900">
            <strong>Leyenda:</strong> <Leaf className="w-4 h-4 text-green-600 inline" /> Vegetariano | 
            <Flame className="w-4 h-4 text-red-500 inline mx-1" /> Picante (1-3 niveles)
          </p>
        </div>

        <SeccionMenu titulo="Quesadillas" items={menu.quesadillas} icono="🫓" />
        <SeccionMenu titulo="Tacos" items={menu.tacos} icono="🌮" />
        <SeccionMenu titulo="Antojitos Grandes" items={menu.antojitos} icono="🍽️" />
        <SeccionMenu titulo="Guarniciones" items={menu.guarniciones} icono="🌽" />
        <SeccionMenu titulo="Bebidas" items={menu.bebidas} icono="🥤" />
      </div>

      {/* Footer */}
      <div className="bg-amber-800 text-white text-center p-6 mt-12">
        <p className="text-lg">¡Buen provecho! 🇲🇽</p>
        <p className="text-amber-200 text-sm mt-2">Todos los platillos preparados con ingredientes frescos del día</p>
      </div>
    </div>
  );
}